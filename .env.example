# Phase 14 Live Fire — 環境変数設定ファイル
#
# このファイルを .env にコピーして使用してください:
#   cp .env.example .env
#
# .env は .gitignore に含まれているため、APIキーがコミットされることはありません。
# ==========================================================================

# [必須] Gemini API キー
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# [省略可] 使用するモデル。default: gemini-2.0-flash
# 構造化出力（responseSchema）対応モデル:
#   gemini-2.0-flash          — 高速・低コスト（デフォルト推奨）
#   gemini-2.0-flash-lite     — さらに低コスト
#   gemini-1.5-pro            — 高品質（候補の reasoning が詳細になる）
#   gemini-1.5-flash          — バランス型
# GEMINI_MODEL=gemini-2.0-flash

# [省略可] LLM に要求する最大パッチ候補数。default: 3
# MAX_CANDIDATES=3

# [省略可] 出力先ルートディレクトリ。default: phase14/data/live_fire_runs/
# LIVE_FIRE_OUT=phase14/data/live_fire_runs
