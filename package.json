{
  "name": "antigravity-phase-1",
  "version": "0.1.0",
  "description": "Antigravity Phase 1: Genesis - Contract + Hub Integrity System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "workflow:validate": "node -e \"const path=require('node:path'); const root=(process.env.INIT_CWD || process.cwd()).replace(/^[\\\\\\\\]{2}[?][\\\\\\\\]/, ''); process.chdir(root); require(path.join(root,'node_modules','ts-node','register')); require(path.join(root,'tools','workflow_runtime','stateMachineValidatorCli.ts'));\"",
    "workflow:event:validate": "node -e \"const path=require('node:path'); const root=(process.env.INIT_CWD || process.cwd()).replace(/^[\\\\\\\\]{2}[?][\\\\\\\\]/, ''); process.chdir(root); require(path.join(root,'node_modules','ts-node','register')); require(path.join(root,'tools','workflow_runtime','validateEventCli.ts'));\" -- --event workflows/samples/valid_workflow_event.v0.1.json",
    "workflow:event:validate:orchestrator": "node -e \"const path=require('node:path'); const root=(process.env.INIT_CWD || process.cwd()).replace(/^[\\\\\\\\]{2}[?][\\\\\\\\]/, ''); process.chdir(root); require(path.join(root,'node_modules','ts-node','register')); require(path.join(root,'tools','workflow_runtime','validateEventCli.ts'));\" -- --event workflows/samples/valid_dynamic_prompt_dispatch_event.v0.1.json",
    "workflow:event:validate:orchestrator:invalid": "node -e \"const path=require('node:path'); const root=(process.env.INIT_CWD || process.cwd()).replace(/^[\\\\\\\\]{2}[?][\\\\\\\\]/, ''); process.chdir(root); require(path.join(root,'node_modules','ts-node','register')); require(path.join(root,'tools','workflow_runtime','validateEventCli.ts'));\" -- --event workflows/samples/invalid_dynamic_prompt_dispatch_event_missing_correlation.v0.1.json",
    "mcp:repo-split": "node -e \"const path=require('node:path'); const root=(process.env.INIT_CWD || process.cwd()).replace(/^[\\\\\\\\]{2}[?][\\\\\\\\]/, ''); require(path.join(root,'tools','repo_split_mcp','launch.js'));\"",
    "workflow:dispatch:audit:telemetry": "node -e \"const path=require('node:path'); const root=(process.env.INIT_CWD || process.cwd()).replace(/^[\\\\\\\\]{2}[?][\\\\\\\\]/, ''); process.chdir(root); require(path.join(root,'node_modules','ts-node','register')); require(path.join(root,'tools','workflow_runtime','dispatchAuditTelemetryCli.ts'));\" -- --out phase14/data/dispatch_audit_metrics.latest.json",
    "mcp:repo-split:smoke": "node -e \"const path=require('node:path'); const root=(process.env.INIT_CWD || process.cwd()).replace(/^[\\\\\\\\]{2}[?][\\\\\\\\]/, ''); process.chdir(root); require(path.join(root,'node_modules','ts-node','register')); require(path.join(root,'tools','repo_split_mcp','smokeTest.ts'));\"",
    "test": "tsc && node dist/tests/tamper_test.js",
    "test:gate": "tsc && node dist/tests/transaction_gate.test.js",
    "test:e2e": "tsc && node dist/tests/nightly_loop_e2e.test.js",
    "test:phase14": "tsc && node dist/tests/phase14_self_improvement_scenario.test.js",
    "test:comparison-json": "tsc && node dist/tests/comparison_json_validator.test.js",
    "test:comparison-governance": "tsc && node dist/tests/comparison_governance_logic.test.js",
    "test:comparison-gate-output": "tsc && node dist/tests/comparison_gate_output.test.js",
    "comparison:gate:json": "tsc && node dist/tools/comparison_gate_cli.js --out phase14/data/comparison_gate_result.latest.json",
    "comparison:gate:strict": "tsc && node dist/tools/comparison_gate_cli.js --policy-profile strict --out phase14/data/comparison_gate_result.strict.json --dry-freeze",
    "comparison:gate:relaxed": "tsc && node dist/tools/comparison_gate_cli.js --policy-profile relaxed --out phase14/data/comparison_gate_result.relaxed.json --dry-freeze",
    "comparison:gate:emergency": "tsc && node dist/tools/comparison_gate_cli.js --policy-profile emergency --out phase14/data/comparison_gate_result.emergency.json --dry-freeze",
    "test:governance": "tsc && node dist/tests/governance/fail_closed.test.js && node dist/tests/invariant/invariant_registry.test.js && node dist/tests/schema/schema_rejection.test.js",
    "test:openclaw": "tsc && node dist/tests/governance/openclaw_gateway_smoke.test.js",
    "verify:constitution": "tsc && node dist/tools/verify_constitution.js",
    "verify:constitution:json": "tsc && node dist/tools/verify_constitution.js --json",
    "ci": "npm run verify:constitution && npm run test:governance && npm test && npm run test:gate",
    "caretaker:observe": "tsc && node dist/tools/repo_caretaker.js",
    "caretaker:observe:json": "tsc && node dist/tools/repo_caretaker.js --json",
    "caretaker:dry-run": "tsc && node dist/tools/repo_caretaker.js --dry-run",
    "caretaker:nightly": "tsc && node dist/tools/repo_caretaker.js --execute",
    "live-fire": "tsc && node dist/tools/collect_repo_inputs.js && node dist/tools/phase14_live_fire.js",
    "live-fire:seed": "tsc && node dist/tools/collect_repo_inputs.js && cross-env USE_SEED_DATA=1 node dist/tools/phase14_live_fire.js",
    "ledger:init": "tsc && node dist/tools/initialize_failure_ledger.js",
    "ledger:init:force": "tsc && node dist/tools/initialize_failure_ledger.js",
    "openclaw": "tsc && node dist/tools/openclaw_cli.js",
    "proof-pack": "tsc && node dist/tools/generate_proof_pack.js",
    "simulator": "npx ts-node contract/rollback_simulator.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "antigravity",
    "phase-1",
    "contract",
    "proof",
    "hash-chain",
    "append-only-log"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.33",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
