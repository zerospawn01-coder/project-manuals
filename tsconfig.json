{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": [
    "contract/**/*.ts",
    "contract/**/*.d.ts",
    "core/**/*.ts",
    "hub/**/*.ts",
    "hub/**/*.d.ts",
    "peripherals/**/*.d.ts",
    "tools/**/*.ts",
    "types/**/*.d.ts",
    "renderer-react/src/**/*.ts",
    "renderer-react/src/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}